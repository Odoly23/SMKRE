# ═══ SMKRE — konfigurasaun (kopia ba .env no muda) ═══
# 1. Seguransa
SECRET_KEY=muda-ida-ne-e-ho-karakter-aleatóriu-50
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DEFAULT_PASSWORD=redebarai@2026
ADMIN_URL=jestaun-smkre/
SITE_URL=http://127.0.0.1:8000

# 4. Database (DEV: sqlite | PROD: postgresql ka mysql)
DB_ENGINE=sqlite
DB_NAME=smkre
DB_USER=smkre
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# 7. Autorizasaun offline (loron)
OFFLINE_PERMISSION_DAYS=7

# Portal públiku (kontaktu iha topbar) — EZEMPLU, troka ho kontaktu loloos Rede ba Rai
PORTAL_TELEFONE=+670 0000 0000
PORTAL_EMAIL=email@exemplu.tl
PORTAL_ENDERESU=Dili, Timor-Leste

# 9. Email (DEV: console | PROD: smtp)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
# Gmail: uza "App Password" (letra 16), LA'ÓS password Gmail normál
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SMKRE Rede ba Rai <noreply@localhost>

# 10. Redis & Celery (DEV: CELERY_ALWAYS_EAGER=True, la presiza Redis)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=True
USE_REDIS_CACHE=False

# 12. Production
SECURE_SSL_REDIRECT=True
# Iha kotuk Nginx: True (IP kliente husi X-Forwarded-For)
BEHIND_PROXY=False
# PythonAnywhere: CLIENT_IP_HEADER=HTTP_X_REAL_IP (haree docs/DEPLOY_PYTHONANYWHERE.md)
CLIENT_IP_HEADER=
