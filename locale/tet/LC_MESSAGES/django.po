msgid "This field is required."
msgstr "Kampu ne'e obrigatóriu."

msgid "Enter a valid email address."
msgstr "Hatama email ida ne'ebé loos."

msgid "Please enter a correct %(username)s and password. Note that both fields may be case-sensitive."
msgstr "Email ka password la loos. Favor koko fali."

msgid "This account is inactive."
msgstr "Konta ne'e la ativu. Kontaktu Admin."

msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "Password tuan la loos. Favor hatama fali."

msgid "The two password fields didn’t match."
msgstr "Password rua la hanesan."

msgid "Old password"
msgstr "Password tuan"

msgid "New password"
msgstr "Password foun"

msgid "New password confirmation"
msgstr "Konfirma password foun"

