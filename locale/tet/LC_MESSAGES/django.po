msgstr "Email"

msgid "This password is too short. It must contain at least %(min_length)d character."
msgid_plural "This password is too short. It must contain at least %(min_length)d characters."
msgstr[0] "Password badak liu. Minimu karakter %(min_length)d."
msgstr[1] "Password badak liu. Minimu karakter %(min_length)d."

msgid "This password is too common."
msgstr "Password ne'e komún liu (fasil atu hatene)."

msgid "This password is entirely numeric."
msgstr "Password labele númeru deit."

msgid "The password is too similar to the %(verbose_name)s."
msgstr "Password besik liu ho %(verbose_name)s."

msgid "Your password can’t be too similar to your other personal information."
msgstr "Password labele besik liu ho ita-nia informasaun pesoál."

msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "Password tenke iha minimu karakter %(min_length)d."
msgstr[1] "Password tenke iha minimu karakter %(min_length)d."

msgid "Your password can’t be a commonly used password."
msgstr "Password labele password komún."

msgid "Your password can’t be entirely numeric."
msgstr "Password labele númeru deit."

msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "Hili opsaun ida ne'ebé loos."

msgid "Upload a valid image. The file you uploaded was either not an image or a corrupted image."
msgstr "Upload imajen ida ne'ebé loos."

msgid "%(model_name)s with this %(field_label)s already exists."
msgstr "%(model_name)s ho %(field_label)s ne'e iha ona."

